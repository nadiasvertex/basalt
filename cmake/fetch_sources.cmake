# Downloads and unpacks every pinned dependency into a directory, for offline builds and for CI
# caches. It also writes an initial cache file that points FetchContent at those copies:
#
#   cmake -D BASALT_SOURCES_DIR=.build/sources -P cmake/fetch_sources.cmake
#   cmake --preset debug -C .build/sources/init.cmake
cmake_minimum_required(VERSION 3.25)

if(NOT BASALT_SOURCES_DIR)
  message(FATAL_ERROR "Set BASALT_SOURCES_DIR to the directory that receives the sources.")
endif()
get_filename_component(sources_dir "${BASALT_SOURCES_DIR}" ABSOLUTE)

include("${CMAKE_CURRENT_LIST_DIR}/dependency_pins.cmake")

set(init_file "${sources_dir}/init.cmake")
file(WRITE "${init_file}" "# Generated by cmake/fetch_sources.cmake.\n")

foreach(name IN ITEMS harfbuzz catch2)
  string(TOUPPER "${name}" upper)
  set(url "${BASALT_${upper}_URL}")
  set(sha256 "${BASALT_${upper}_SHA256}")
  string(REGEX MATCH "[^/]+$" archive_name "${url}")
  set(archive "${sources_dir}/downloads/${archive_name}")
  set(destination "${sources_dir}/${name}")

  file(DOWNLOAD "${url}" "${archive}" EXPECTED_HASH "SHA256=${sha256}" TLS_VERIFY ON
    STATUS status)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Downloading ${url} failed: ${status}")
  endif()

  set(staging "${sources_dir}/staging/${name}")
  file(REMOVE_RECURSE "${staging}" "${destination}")
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${staging}")
  file(GLOB top_level LIST_DIRECTORIES true "${staging}/*")
  list(LENGTH top_level count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "${archive_name} should hold one top-level directory, not ${count}.")
  endif()
  file(RENAME "${top_level}" "${destination}")
  file(REMOVE_RECURSE "${staging}")

  file(APPEND "${init_file}"
    "set(FETCHCONTENT_SOURCE_DIR_${upper} \"${destination}\" CACHE PATH \"\")\n")
  message(STATUS "${name}: ${destination}")
endforeach()

file(REMOVE_RECURSE "${sources_dir}/staging")
